{
  "name": "helpdeck",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Embeddable AI support chatbot: Express + TypeScript backend with its own context-window memory and keyless BM25 retrieval, a React chat widget, and optional spanlight tracing.",
  "license": "MIT",
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "start": "tsx server/index.ts",
    "build": "tsc --noEmit && tsc --noEmit -p widget",
    "test": "vitest run",
    "widget:dev": "vite --config widget/vite.config.ts",
    "widget:build": "vite build --config widget/vite.config.ts",
    "eval": "tsx evals/run.ts",
    "eval:check": "tsx evals/run.ts --check"
  },
  "dependencies": {
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/supertest": "^6.0.2",
    "@vitejs/plugin-react": "^6.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.0",
    "vitest": "^5.0.5"
  }
}
